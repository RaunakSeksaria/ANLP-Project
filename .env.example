# Copy to .env (gitignored) and fill in only what you use.
# Data generation (data_generation/scripts/generate_neutral.py); pick the variable
# with --api-key-env, default NVIDIA_API_KEY for --provider nvidia
NVIDIA_API_KEY=
GEMINI_API_KEY=
# Private Hugging Face repos (splits/download_hf.py, model checkpoints)
HF_TOKEN=
# Weights & Biases logging for training (optional; uv sync --extra tracking)
WANDB_API_KEY=
# Jev zero-shot classifier (generation_eval/jev); read from generation_eval/.env
# JEV_API=
